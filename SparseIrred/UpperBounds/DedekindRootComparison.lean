import SparseIrred.UpperBounds.PrimeIdealComparison
import SparseIrred.UpperBounds.MonicScaling

/-!
# Good-prime root counts and Dedekind factorization

This file derives the Kummer–Dedekind index condition from an integral
power-basis discriminant. The standard equality between the algebra
discriminant of a power basis and the polynomial discriminant is kept as an
explicit equality input. The conductor argument and nonmonic change of
variables are proved here.
-/

namespace SparseIrred.UpperBounds

open Polynomial NumberField

/-- An integer representing the discriminant of a rational power basis lies
in the conductor of the order generated by its integral generator. -/
theorem powerBasis_discr_mem_conductor (K : Type*) [Field K] [NumberField K]
    (θ : 𝓞 K) (B : PowerBasis ℚ K) (hgen : B.gen = (θ : K))
    (D : ℤ) (hdiscr : Algebra.discr ℚ B.basis = (D : ℚ)) :
    (D : 𝓞 K) ∈ conductor ℤ θ := by
  rw [mem_conductor_iff]
  intro z
  have hint : IsIntegral ℤ B.gen := hgen.symm ▸ θ.isIntegral_coe
  have hm := Algebra.discr_mul_isIntegral_mem_adjoin ℚ hint z.isIntegral_coe
  rw [hgen, hdiscr] at hm
  have hmap :
      (Algebra.adjoin ℤ {θ}).map (IsScalarTower.toAlgHom ℤ (𝓞 K) K) =
        Algebra.adjoin ℤ {(θ : K)} := by
    rw [AlgHom.map_adjoin, Set.image_singleton]
    rfl
  have hm' : ((D : 𝓞 K) * z : 𝓞 K).val ∈ Algebra.adjoin ℤ {(θ : K)} := by
    change (algebraMap (𝓞 K) K) ((D : 𝓞 K) * z) ∈ _
    rw [map_mul, map_intCast]
    change (D : K) * (z : K) ∈ _
    simpa only [Algebra.smul_def, map_intCast] using hm
  rw [← hmap] at hm'
  obtain ⟨w, hw, heq⟩ := hm'
  have heq' : w = (D : 𝓞 K) * z := by
    apply Subtype.ext
    exact heq
  exact heq' ▸ hw

/-- The exponent of an integral generator divides every integer representing
the discriminant of its rational power basis. -/
theorem exponent_dvd_powerBasis_discr (K : Type*) [Field K] [NumberField K]
    (θ : 𝓞 K) (B : PowerBasis ℚ K) (hgen : B.gen = (θ : K))
    (D : ℤ) (hdiscr : Algebra.discr ℚ B.basis = (D : ℚ)) :
    (RingOfIntegers.exponent θ : ℤ) ∣ D := by
  exact Int.cast_mem_ideal_iff.mp
    (powerBasis_discr_mem_conductor K θ B hgen D hdiscr)

/-- Avoiding the power-basis discriminant implies the exact index condition
required by mathlib's Kummer–Dedekind theorem. -/
theorem not_dvd_exponent_of_not_dvd_powerBasis_discr
    (K : Type*) [Field K] [NumberField K]
    (θ : 𝓞 K) (B : PowerBasis ℚ K) (hgen : B.gen = (θ : K))
    (D : ℤ) (hdiscr : Algebra.discr ℚ B.basis = (D : ℚ))
    (p : ℕ) (hp : ¬(p : ℤ) ∣ D) : ¬p ∣ RingOfIntegers.exponent θ := by
  intro h
  apply hp
  exact (Int.natCast_dvd_natCast.mpr h).trans
    (exponent_dvd_powerBasis_discr K θ B hgen D hdiscr)

/-- Good-prime Dedekind correspondence for an integral primitive generator.
The equality input is the standard power-basis discriminant identity. -/
theorem rootCount_minpoly_eq_degreeOnePrimesOver_of_discr
    (K : Type*) [Field K] [NumberField K]
    (θ : 𝓞 K) (B : PowerBasis ℚ K) (hgen : B.gen = (θ : K))
    (hdiscr : Algebra.discr ℚ B.basis = ((minpoly ℤ θ).discr : ℚ))
    (p : ℕ) [Fact p.Prime] (hp : ¬(p : ℤ) ∣ (minpoly ℤ θ).discr) :
    rootCount ((minpoly ℤ θ).map (Int.castRingHom (ZMod p))) =
      Nat.card {P : (Ideal.span {(p : ℤ)}).primesOver (𝓞 K) // P.val.inertiaDeg ℤ = 1} :=
  rootCount_minpoly_eq_degreeOnePrimesOver K θ p
    (not_dvd_exponent_of_not_dvd_powerBasis_discr K θ B hgen _ hdiscr p hp)

/-- The nonmonic form of Lemma 3.2: at a prime avoiding the original leading
coefficient and discriminant, the original modular roots count the degree-one
prime ideals in the field generated by its scaled integral root. -/
theorem nonmonic_rootCount_eq_degreeOnePrimesOver
    (K : Type*) [Field K] [NumberField K]
    (f : ℤ[X]) (hd : 1 ≤ f.natDegree) (θ : 𝓞 K)
    (hmin : minpoly ℤ θ = f.integralNormalization)
    (B : PowerBasis ℚ K) (hgen : B.gen = (θ : K))
    (hdiscr : Algebra.discr ℚ B.basis = (f.integralNormalization.discr : ℚ))
    (p : ℕ) [Fact p.Prime] (ha : ¬(p : ℤ) ∣ f.leadingCoeff)
    (hfdisc : ¬(p : ℤ) ∣ f.discr) :
    rootCount (f.map (Int.castRingHom (ZMod p))) =
      Nat.card {P : (Ideal.span {(p : ℤ)}).primesOver (𝓞 K) // P.val.inertiaDeg ℤ = 1} := by
  rw [monicScaling_mod_rootCount f hd p ha, ← hmin]
  apply rootCount_minpoly_eq_degreeOnePrimesOver_of_discr K θ B hgen
  · simpa only [hmin] using hdiscr
  · rw [hmin]
    exact monicScaling_not_dvd_discr f hd p ha hfdisc

end SparseIrred.UpperBounds
