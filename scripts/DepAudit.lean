run_cmd do
  let env ← getEnv
  let mut visited : NameSet := {}
  let mut stack := roots
  let mut axioms : Array Name := #[]
  while !stack.isEmpty do
    let n := stack.head!
    stack := stack.tail!
    if visited.contains n then continue
    visited := visited.insert n
    match env.find? n with
    | none => throwError m!"Dependency audit references missing declaration: {n}"
    | some ci =>
      if ci matches .axiomInfo _ then axioms := axioms.push n
      for m in ci.getUsedConstantsAsSet do
        unless visited.contains m do stack := m :: stack
  let mut pkg : Std.HashMap String Nat := {}
  let mut mods : Std.HashMap Name Nat := {}
  for n in visited do
    match env.getModuleIdxFor? n with
    | none => pkg := pkg.insert "(current)" (pkg.getD "(current)" 0 + 1)
    | some idx =>
      let mn := env.header.moduleNames[idx.toNat]!
      let p := mn.getRoot.toString
      pkg := pkg.insert p (pkg.getD p 0 + 1)
      if p == "Complexitylib" || p == "SparseDivComplexity" || p == "SparseGcd" then
        mods := mods.insert mn (mods.getD mn 0 + 1)
  logInfo m!"constants reached: {visited.size}"
  for (p, c) in pkg.toList.toArray.qsort (fun a b => a.2 > b.2) do
    logInfo m!"  package {p}: {c}"
  for (m, c) in mods.toList.toArray.qsort (fun a b => a.1.toString < b.1.toString) do
    logInfo m!"  module {m}: {c}"
  logInfo m!"axioms reached: {axioms}"
  for n in axioms do
    unless n == ``propext || n == ``Classical.choice || n == ``Quot.sound do
      throwError m!"Unexpected axiom in dependency closure: {n}"
